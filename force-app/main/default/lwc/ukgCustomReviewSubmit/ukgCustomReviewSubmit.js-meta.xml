<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Custom Review Period Tracker</masterLabel>
    <description>Allows manual selection of review dates for UKG data retrieval on a Contact record.</description>
    
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
             <!-- Component requires the Contact record context to get the UKG ID and Hire Date -->
            <objects>
                <object>Contact</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
