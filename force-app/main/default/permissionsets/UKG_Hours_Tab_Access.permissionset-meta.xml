<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>UKG Hours Tab Access</label>
    <description>Everything on the Contact record Hours tab: Weekly Time Sheet, UKG Bench Time Summary, Billable Hours Tracker and Annual Review Summary. Read-only access to UKG time via Apex.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <!-- Weekly Time Sheet (ukgTimesheetWeek) -->
    <classAccesses>
        <apexClass>UkgTimesheetController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- UKG Bench Time Summary (ukgTimeTracker) -->
    <classAccesses>
        <apexClass>UkgDataController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- Billable Hours Tracker (ukgBillableHoursTracker); delegates to UkgBillableHoursW2Controller -->
    <classAccesses>
        <apexClass>UkgBillableHoursController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UkgBillableHoursW2Controller</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- Annual Review Summary (ukgCustomReviewSubmit) -->
    <classAccesses>
        <apexClass>UkgReviewDataController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- Contact fields the components and page visibility rules read -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.HPG_Title__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.Hire_Date_Anniversary__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.UKG_Employee_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.UKG_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
